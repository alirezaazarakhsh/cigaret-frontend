# Sevin Wholesale Tobacco Frontend - Environment Variables
PORT=3000
NODE_ENV=production

# Base URL for Backend API Endpoints (Django / Express / FastAPI)
VITE_API_BASE_URL=https://cigaretsevin.vercel.app/api/v1

# Frontend Production Web App URL (Vercel)
VITE_APP_URL=https://cigaretsevin.vercel.app

# Commercial Distribution Mode:
# 'full_suite' (default): Online storefront + POS Cashier & Accounting system
# 'pos_only': Standalone POS Cashier & Warehouse system for offline/in-store clients
# 'online_store_only': Standalone E-commerce storefront
VITE_APP_MODE=full_suite

